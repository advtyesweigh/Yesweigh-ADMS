SECRET_KEY=generate-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow!
HOST=0.0.0.0
PORT=8081
PUBLIC_BASE_URL=http://103.176.85.102:8081
DB_PATH=/opt/adms/data/adms.db
# Durable attendance before device ACK (existing VPS Postgres — gatc-postgres :5433)
# DATABASE_URL=postgresql://adms:CHANGE_ME@127.0.0.1:5433/adms
FIREBASE_ENABLED=false
FIREBASE_COMPANY_ID=default
FIREBASE_CREDENTIALS_PATH=/opt/adms/secrets/firebase-service-account.json
TIMEZONE_DEFAULT=Asia/Kolkata
AUTO_APPROVE_DEVICES=false
# Keep false until X305 Pro USERINFO is verified (docs/X305_PRO_USERINFO.md)
AUTO_SYNC_USERS=false
SYNC_INTERVAL_SECONDS=20
# Online ≤45s (~3× Delay), Unstable 45–120s, Offline >120s
DEVICE_ONLINE_SECONDS=45
DEVICE_OFFLINE_SECONDS=120
# Handshake Delay=15 ErrorDelay=30 (device poll / retry)
HEARTBEAT_INTERVAL_HINT=15
HANDSHAKE_ERROR_DELAY=30
HEARTBEAT_WATCHDOG_SECONDS=30
HTTP_KEEP_ALIVE_SECONDS=5
